<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarkLite</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- NativeAOT + trimming — settings proven by the AotSpike project -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Viewer app: favor small working set over GC throughput. -->
    <GCConserveMemory>9</GCConserveMemory>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- NU1903: Tmds.DBus.Protocol advisory — transitive, Linux-only DBus client, never runs on Windows. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled fonts: Fira Code Retina (OFL) for code, Roboto (Apache-2.0) and
         Lexend (OFL) as selectable body faces — no system-install dependency. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- Markdig-based rendering stack (replaces Markdown.Avalonia.Tight; spike-proven under AOT). -->
    <PackageReference Include="MarkView.Avalonia" Version="12.2.1" />
    <PackageReference Include="MarkView.Avalonia.Mermaid" Version="12.2.1" />
    <PackageReference Include="MarkView.Avalonia.Math" Version="12.2.1" />
    <!-- Syntax highlighting: pure managed regex engine, AOT/trim safe. Chosen over the
         TextMate satellite package, which costs ~19 MB of grammar assets in the exe. -->
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
  </ItemGroup>
</Project>
