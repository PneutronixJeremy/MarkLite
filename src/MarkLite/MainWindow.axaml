<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarkLite.MainWindow"
        Title="MarkLite"
        Icon="avares://MarkLite/Assets/MarkLite.ico"
        Width="1000" Height="750"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="Button.TocEntry">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource MdMutedForeground}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.TocEntry:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MdInlineCodeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MdBodyForeground}" />
        </Style>
        <Style Selector="Button.TocEntryCurrent">
            <Setter Property="Background" Value="{DynamicResource MdInlineCodeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MdAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="8,3,2,3" />
        </Style>
        <Style Selector="Border.TabItemActive">
            <Setter Property="Background" Value="{DynamicResource MdInlineCodeBackground}" />
        </Style>
        <Style Selector="Border.TabItem Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MdMutedForeground}" />
        </Style>
        <Style Selector="Border.TabItemActive Button.TabName">
            <Setter Property="Foreground" Value="{DynamicResource MdBodyForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.TabItemStale Button.TabName">
            <Setter Property="Foreground" Value="{DynamicResource MdStaleBannerForeground}" />
        </Style>
        <Style Selector="Border.TabItem Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MdTableRowAltBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MdBodyForeground}" />
        </Style>
    </Window.Styles>

    <DockPanel Background="{DynamicResource MdPageBackground}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Click="OnOpenClicked" />
                <MenuItem Header="_Close tab" Click="OnCloseTabClicked" InputGesture="Ctrl+W" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Click="OnCopyClicked" InputGesture="Ctrl+C" />
                <MenuItem Header="Select _all" Click="OnSelectAllClicked" InputGesture="Ctrl+A" />
                <Separator />
                <MenuItem Header="_Find…" Click="OnFindClicked" InputGesture="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Contents sidebar" Click="OnToggleTocClicked" InputGesture="Ctrl+T" />
                <MenuItem Name="BodyFontMenu" Header="_Body font">
                    <MenuItem Header="_Roboto" Click="OnBodyFontClicked" ToggleType="Radio" IsChecked="True"
                              Tag="fonts:MarkLite#Roboto" />
                    <MenuItem Header="_Google Sans" Click="OnBodyFontClicked" ToggleType="Radio"
                              Tag="fonts:MarkLite#Google Sans" />
                    <MenuItem Header="_Lexend" Click="OnBodyFontClicked" ToggleType="Radio"
                              Tag="fonts:MarkLite#Lexend" />
                    <MenuItem Header="_Segoe UI" Click="OnBodyFontClicked" ToggleType="Radio"
                              Tag="Segoe UI Variable Text, Segoe UI, sans-serif" />
                </MenuItem>
                <MenuItem Name="ShowHtmlCommentsItem" Header="Show _HTML comments"
                          Click="OnShowHtmlCommentsClicked" ToggleType="CheckBox" IsChecked="True" />
                <MenuItem Name="ShowLineNumbersItem" Header="Show _line numbers"
                          Click="OnShowLineNumbersClicked" ToggleType="CheckBox" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Name="RegisterOpenWithItem"
                          Header="Register 'Open with' for .md/.markdown"
                          ToggleType="CheckBox"
                          Click="OnRegisterOpenWithClicked" />
                <MenuItem Header="Make MarkLite the _default…" Click="OnMakeDefaultClicked" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for updates" Click="OnCheckForUpdatesClicked" />
            </MenuItem>
        </Menu>
        <Border Name="TabStripBorder"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="{DynamicResource MdTableHeaderBackground}"
                BorderBrush="{DynamicResource MdTableBorder}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Name="TabStrip" Orientation="Horizontal" Spacing="2" Margin="4,3,4,0" />
            </ScrollViewer>
        </Border>
        <Border Name="FindBar"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="{DynamicResource MdTableHeaderBackground}"
                BorderBrush="{DynamicResource MdTableBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="FindBox" Width="260" PlaceholderText="Find in document" FontSize="12.5" />
                <TextBlock Name="FindCountText"
                           VerticalAlignment="Center"
                           MinWidth="70"
                           FontSize="12.5"
                           Foreground="{DynamicResource MdMutedForeground}" />
                <Button Content="▲" Click="OnFindPrevClicked" ToolTip.Tip="Previous match (Shift+F3)" />
                <Button Content="▼" Click="OnFindNextClicked" ToolTip.Tip="Next match (F3)" />
                <Button Content="✕" Click="OnFindCloseClicked" ToolTip.Tip="Close (Esc)" />
            </StackPanel>
        </Border>
        <Border Name="StaleBanner"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="{DynamicResource MdStaleBannerBackground}"
                Padding="10,4">
            <TextBlock Name="StaleText"
                       Foreground="{DynamicResource MdStaleBannerForeground}"
                       FontSize="12.5" />
        </Border>
        <!--  Notice banner: update availability, the one-time "Open with" offer,
              and similar non-blocking notices. One optional action button whose
              label/behavior the caller sets, plus dismiss.  -->
        <Border Name="NoticeBanner"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="{DynamicResource MdStaleBannerBackground}"
                Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Name="NoticeText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MdStaleBannerForeground}"
                           FontSize="12.5" />
                <Button Name="NoticeActionButton"
                        IsVisible="False"
                        FontSize="12.5"
                        Click="OnNoticeActionClicked" />
                <Button Name="NoticeSecondaryButton"
                        IsVisible="False"
                        FontSize="12.5"
                        Click="OnNoticeSecondaryClicked" />
                <Button Content="✕"
                        FontSize="12.5"
                        ToolTip.Tip="Dismiss"
                        Click="OnNoticeDismissClicked" />
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="Auto,*">
            <Border Name="TocPanel"
                    Grid.Column="0"
                    Width="250"
                    IsVisible="False"
                    Background="{DynamicResource MdTableHeaderBackground}"
                    BorderBrush="{DynamicResource MdTableBorder}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer Name="TocScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="TocList" Margin="6,8" Spacing="1" />
                </ScrollViewer>
            </Border>
            <!--  Every tab's viewer lives here permanently; only the active one is
                  visible, and only the active one holds a rendered document (see
                  ActivateTab). Viewers stay attached so their template — and the
                  ScrollViewer the scroll hook rides on — is built only once.  -->
            <Panel Name="ViewerHost" Grid.Column="1" />
        </Grid>
    </DockPanel>
</Window>
