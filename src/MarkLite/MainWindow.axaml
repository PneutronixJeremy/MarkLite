<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarkLite.MainWindow"
        Title="MarkLite"
        Width="1000" Height="750"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="Button.TocEntry">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource MdMutedForeground}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.TocEntry:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MdInlineCodeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MdBodyForeground}" />
        </Style>
        <Style Selector="Button.TocEntryCurrent">
            <Setter Property="Background" Value="{DynamicResource MdInlineCodeBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MdAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <DockPanel Background="{DynamicResource MdPageBackground}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Click="OnOpenClicked" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Contents sidebar" Click="OnToggleTocClicked" InputGesture="Ctrl+T" />
            </MenuItem>
        </Menu>
        <Border Name="StaleBanner"
                DockPanel.Dock="Top"
                IsVisible="False"
                Background="{DynamicResource MdStaleBannerBackground}"
                Padding="10,4">
            <TextBlock Name="StaleText"
                       Foreground="{DynamicResource MdStaleBannerForeground}"
                       FontSize="12.5" />
        </Border>
        <Grid ColumnDefinitions="Auto,*">
            <Border Name="TocPanel"
                    Grid.Column="0"
                    Width="250"
                    IsVisible="False"
                    Background="{DynamicResource MdTableHeaderBackground}"
                    BorderBrush="{DynamicResource MdTableBorder}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer Name="TocScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="TocList" Margin="6,8" Spacing="1" />
                </ScrollViewer>
            </Border>
            <ContentControl Name="ViewerHost" Grid.Column="1" />
        </Grid>
    </DockPanel>
</Window>
