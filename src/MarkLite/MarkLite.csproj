<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MarkLite</RootNamespace>
    <!-- Single source of truth for the app version; build/pack.ps1 reads it for vpk. -->
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe icon; the same .ico is linked below as an AvaloniaResource for the
         window/taskbar icon, and build/pack.ps1 hands it to vpk for the installer. -->
    <ApplicationIcon>..\..\assets\MarkLite.ico</ApplicationIcon>

    <!-- NativeAOT + trimming — settings proven by the AotSpike project -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>link</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--  Symbols are not part of the deployment: they dwarf it (~250 MB of pdb
          against a ~52 MB app). DebugType=none is the lever for the ILC native
          pdb — setting NativeDebugSymbols here does nothing, because the
          ilcompiler targets import after this and re-derive it from DebugType.
          Release only, so Debug builds stay debuggable; the SkiaSharp and
          HarfBuzz native pdbs arrive as publish items from their runtime
          packages and are dropped by the target at the bottom of this file.  -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- Viewer app: favor small working set over GC throughput. -->
    <GCConserveMemory>9</GCConserveMemory>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- NU1903: Tmds.DBus.Protocol advisory — transitive, Linux-only DBus client, never runs on Windows. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The app is an exe with no public API of its own; the unit tests reach
         its internals rather than forcing types public for testing's sake. -->
    <InternalsVisibleTo Include="MarkLite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts: Fira Code Retina (OFL) for code, Roboto (Apache-2.0) and
         Lexend (OFL) as selectable body faces — no system-install dependency. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="..\..\assets\MarkLite.ico" Link="Assets\MarkLite.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- Markdig-based rendering stack (replaces Markdown.Avalonia.Tight; spike-proven under AOT). -->
    <PackageReference Include="MarkView.Avalonia" Version="12.2.1" />
    <PackageReference Include="MarkView.Avalonia.Math" Version="12.2.1" />
    <!-- Mermaid: the diagram engine and the SVG control directly, without
         MarkView.Avalonia.Mermaid. Its block renderer is vendored (and fixed)
         in Rendering/MermaidFenceRenderer.cs, so the package itself would only
         add a renderer that crashes on the second detach. Versions match what
         MarkView.Avalonia.Mermaid 12.2.1 depended on. -->
    <PackageReference Include="Mermaider" Version="0.12.2" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
    <!-- Syntax highlighting: pure managed regex engine, AOT/trim safe. Chosen over the
         TextMate satellite package, which costs ~19 MB of grammar assets in the exe. -->
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <!-- Install/update framework (Squirrel successor); packs via the vpk CLI,
         updates from GitHub Releases. Verified AOT/trim clean. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Keep symbol files out of the published deployment (see NativeDebugSymbols above). -->
  <Target Name="ExcludeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
